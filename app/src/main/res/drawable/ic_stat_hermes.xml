<?xml version="1.0" encoding="utf-8"?>
<!--
  通知栏「小图标」（状态栏 / 通知左侧那个）。

  为什么用矢量图而不是 PNG 位图：小图标会被系统强制渲染成单色剪影，彩色位图进去只会
  被压成一块实心色；而且位图形式（尤其是带 alpha 的灰度 PNG）在部分 ROM 的通知图标
  路径上会加载失败，系统就退回它自己的占位图 —— 用户在那台机器上看到的就是这个：
  左侧显示的是系统的「机器人＋网格」占位图，而不是本应用的图标（实测截图逐像素比对：
  与 App 图标相关系数 -0.20，与系统占位图一致）。矢量图是 Android 官方推荐的小图标
  形式，任何 ROM 都能正确解析。

  形状取 App 图标的外轮廓（圆角方块）。坐标按 24dp 画布。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M7,2 H17 A5,5 0 0 1 22,7 V17 A5,5 0 0 1 17,22 H7 A5,5 0 0 1 2,17 V7 A5,5 0 0 1 7,2 Z" />
</vector>
